{
  "compilerOptions": {
    "target": "esnext",
    "lib": ["dom", "dom.iterable"],
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "verbatimModuleSyntax": true,
    "noFallthroughCasesInSwitch": true,
    "sourceMap": true,
    "module": "commonjs",
    // moduleResolution: "node" chosen for consistency with apps/cli and CommonJS compatibility
    // - Shared types are consumed via workspace protocol by apps/cli
    // - "node" resolution matches the CLI's import patterns and build expectations
    // - Prevents type/resolution mismatches between workspace packages
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "outDir": "dist",
    "rootDir": ".",
    "baseUrl": ".",
    "declaration": true,
    "declarationMap": true,
  },
  "include": [".", "github"],
  "exclude": ["**/node_modules", "third-party"]
}
