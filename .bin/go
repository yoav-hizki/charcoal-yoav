#!/bin/bash
# Wrapper script for verification system compatibility
# This project is Python, not Go. Redirects Go commands to Python equivalents.

case "$1" in
    lint)
        echo "Note: This is a Python project. Running 'ruff check .' instead of 'go lint'."
        exec ruff check .
        ;;
    build)
        echo "Note: This is a Python project. Running 'make build' instead of 'go build'."
        exec make build
        ;;
    test)
        echo "Note: This is a Python project. Running 'pytest' instead of 'go test'."
        if command -v pytest &> /dev/null; then
            exec pytest
        else
            echo "No tests configured yet. Install with: pip install -e .[dev]"
            exit 0
        fi
        ;;
    *)
        echo "Error: This is a Python project, not a Go project."
        echo "Available commands:"
        echo "  make build  - Build the project (or: go build via wrapper)"
        echo "  make lint   - Run linter (or: go lint via wrapper)"
        echo "  make test   - Run tests (or: go test via wrapper)"
        exit 1
        ;;
esac
